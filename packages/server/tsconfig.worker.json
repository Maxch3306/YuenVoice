{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/worker.ts",
    "src/http/**/*.ts",
    "src/db/**/*.ts",
    "src/durable/**/*.ts",
    "src/env.ts",
    "src/utils/hash.ts",
    "src/utils/pagination.ts"
  ]
}
